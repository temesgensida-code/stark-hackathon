# API (apps/api). Without Docker/Postgres, use DATABASE_URL=sqlite:///./braille_talks.db
DATABASE_URL=postgresql+psycopg://braille:braille@localhost:5432/braille_talks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
SCHOLARXIV_API_KEY=sxv_...
SCHOLARXIV_API_URL=https://www.scholarxiv.com/api/v1
LLM_BASE_URL=https://www.scholarxiv.com/api/v1/router
# Leave empty to reuse SCHOLARXIV_API_KEY for the Router
LLM_API_KEY=
LLM_MODEL=auto
# inline = parse in the API process (no Redis needed); rq = Redis worker (docker-compose sets this)
JOB_BACKEND=inline
UPLOAD_DIR=uploads

# Web (apps/web) - copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VOXIDE_PUBLIC_KEY=vox_pub_...
